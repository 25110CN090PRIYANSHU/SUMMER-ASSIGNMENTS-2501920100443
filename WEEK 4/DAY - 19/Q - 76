# Program to find the sum of principal and secondary diagonals

n = int(input("Enter the order of the square matrix: "))

matrix = []

print("Enter the elements of the matrix:")
for i in range(n):
    row = []
    for j in range(n):
        row.append(int(input()))
    matrix.append(row)

primary_sum = 0
secondary_sum = 0

for i in range(n):
    primary_sum += matrix[i][i]
    secondary_sum += matrix[i][n - 1 - i]

print("Sum of principal diagonal:", primary_sum)
print("Sum of secondary diagonal:", secondary_sum)
