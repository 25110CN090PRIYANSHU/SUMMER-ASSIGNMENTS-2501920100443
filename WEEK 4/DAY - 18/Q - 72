# Program to sort an array in descending order

n = int(input("Enter number of elements: "))

arr = []

print("Enter the elements:")
for i in range(n):
    arr.append(int(input()))

for i in range(n - 1):
    for j in range(i + 1, n):
        if arr[i] < arr[j]:
            arr[i], arr[j] = arr[j], arr[i]

print("Array in descending order:")
print(arr)
