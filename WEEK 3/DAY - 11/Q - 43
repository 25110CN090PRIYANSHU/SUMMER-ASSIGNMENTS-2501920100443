# Function to check whether a number is prime
def is_prime(n):
    if n <= 1:
        return False

    for i in range(2, n):
        if n % i == 0:
            return False

    return True

# Input from user
num = int(input("Enter a number: "))

# Function call and output
if is_prime(num):
    print("Prime Number")
else:
    print("Not a Prime Number")
