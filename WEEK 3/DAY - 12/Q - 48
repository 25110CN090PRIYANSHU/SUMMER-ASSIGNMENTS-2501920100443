# Function to check Perfect Number
def is_perfect(n):
    total = 0

    for i in range(1, n):
        if n % i == 0:
            total += i

    return total == n

# Input from user
num = int(input("Enter a number: "))

# Function call and output
if is_perfect(num):
    print("Perfect Number")
else:
    print("Not a Perfect Number")
