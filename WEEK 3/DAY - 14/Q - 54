# Program to find frequency of an element in an array

n = int(input("Enter number of elements: "))

arr = []
for i in range(n):
    arr.append(int(input()))

key = int(input("Enter element to find frequency: "))

count = 0

for i in arr:
    if i == key:
        count += 1

print("Frequency of", key, "is", count)
