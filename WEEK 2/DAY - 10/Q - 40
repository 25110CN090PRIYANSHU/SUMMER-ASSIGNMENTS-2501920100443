# WAP to print Character Pyramid Pattern

rows = int(input("Enter number of rows: "))

for i in range(rows):

    # Print spaces
    for j in range(rows - i - 1):
        print(" ", end="")

    # Print A to current character
    for j in range(i + 1):
        print(chr(65 + j), end="")

    # Print characters in reverse
    for j in range(i - 1, -1, -1):
        print(chr(65 + j), end="")

    print()
