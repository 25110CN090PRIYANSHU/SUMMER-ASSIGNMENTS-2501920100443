books = []

def add_book():
    book = input("Enter Book Name: ")
    books.append(book)
    print("Book Added Successfully.")

def issue_book():
    book = input("Enter Book Name to Issue: ")

    if book in books:
        books.remove(book)
        print("Book Issued.")
    else:
        print("Book Not Available.")

def show_books():
    print("\nAvailable Books:")
    for b in books:
        print(b)

while True:
    print("\n1.Add Book")
    print("2.Issue Book")
    print("3.Show Books")
    print("4.Exit")

    ch = input("Enter Choice: ")

    if ch == '1':
        add_book()
    elif ch == '2':
        issue_book()
    elif ch == '3':
        show_books()
    elif ch == '4':
        break
    else:
        print("Invalid Choice")
