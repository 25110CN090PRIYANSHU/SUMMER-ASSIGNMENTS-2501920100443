print("***** MARKSHEET GENERATION SYSTEM *****")

roll = input("Enter Roll Number: ")
name = input("Enter Student Name: ")
student_class = input("Enter Class: ")

m1 = float(input("Enter marks of English: "))
m2 = float(input("Enter marks of Maths: "))
m3 = float(input("Enter marks of Science: "))
m4 = float(input("Enter marks of Social Science: "))
m5 = float(input("Enter marks of Computer: "))

total = m1 + m2 + m3 + m4 + m5
percentage = total / 5

if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 40:
    grade = "D"
else:
    grade = "F"

if percentage >= 40:
    result = "PASS"
else:
    result = "FAIL"

print("\n******** MARKSHEET ********")
print("Roll Number :", roll)
print("Name        :", name)
print("Class       :", student_class)
print("----------------------------")
print("English     :", m1)
print("Maths       :", m2)
print("Science     :", m3)
print("Social Sci. :", m4)
print("Computer    :", m5)
print("----------------------------")
print("Total Marks :", total, "/500")
print("Percentage  :", round(percentage, 2), "%")
print("Grade       :", grade)
print("Result      :", result)
print("****************************")
